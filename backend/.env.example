# [공용] backend/.env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 자동으로 읽지 않는다. backend/ 에서: set -a; . ./.env; set +a; mvn spring-boot:run   (Docker 는 --env-file .env)
# 주의: DB_URL 을 넣고 켜면 그 DB 에 Flyway 마이그레이션이 실행된다. 로컬 DB 를 쓰면 DB_* 는 지운다.

# DB (비우면 안 되고, 로컬이면 줄을 지운다)
# DB_URL=jdbc:postgresql://localhost:5432/safetrip
# DB_USER=
# DB_PASSWORD=

# LLM: OpenAI 호환 유료 API. 로컬 Ollama 를 쓰면 AI_* 줄을 모두 지운다(기본값 사용)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com
AI_MODEL=
# Claude 를 쓸 때: AI_PROVIDER=claude, AI_BASE_URL=https://api.anthropic.com, AI_MODEL=claude-haiku-5-5
AI_API_KEY=
# 100만 토큰당 원(모델 단가). 0 이면 유료 호출을 막는다. 빈 값으로 두면 서버가 뜨지 않는다
AI_INPUT_KRW_PER_MTOK=0
AI_OUTPUT_KRW_PER_MTOK=0
# 이 PC 의 월 한도(원)
AI_MONTHLY_BUDGET_KRW=3000

# 임베딩(bge-m3). 기본은 로컬 Ollama라 보통 넣지 않는다
# EMBED_BASE_URL=http://localhost:11434

# 한국관광공사 TourAPI (data.go.kr)
TOUR_API_KEY=
# 긴급: 국립중앙의료원 응급실·약국(data.go.kr), V-World 좌표→주소
NMC_API_KEY=
VWORLD_API_KEY=
