# [공용] backend/.env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 자동으로 읽지 않는다. backend/ 에서: set -a; . ./.env; set +a; mvn spring-boot:run   (Docker 는 --env-file .env)
# 주의: DB_URL 을 넣고 켜면 그 DB 에 Flyway 마이그레이션이 실행된다. 로컬 DB 를 쓰면 DB_* 는 지운다.

# DB (비우면 안 되고, 로컬이면 줄을 지운다)
# DB_URL=jdbc:postgresql://localhost:5432/safetrip
# DB_USER=
# DB_PASSWORD=
# 공용 DB(#140)에 붙을 때는 꼭 켠다. 병합 전 테이블 변경이 모두에게 적용되는 것을 막는다
# SPRING_FLYWAY_ENABLED=false

# LLM: 기본은 Claude API(claude-haiku-5-5). 키만 넣는다. 키를 받는 곳은 연수(#134)
AI_API_KEY=
# 다른 모델·제공사를 쓸 때만 아래 줄을 켠다. 빈 값으로 켜면 기본값을 덮어써 서버가 뜨지 않거나 호출이 막힌다
# AI_PROVIDER=claude
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-haiku-5-5
# AI_INPUT_KRW_PER_MTOK=140
# AI_OUTPUT_KRW_PER_MTOK=700
# 로컬 Ollama LLM(시험용): AI_PROVIDER=ollama, AI_BASE_URL=http://localhost:11434, AI_MODEL=qwen3.5:4b
# 이 PC 의 월 한도(원)
AI_MONTHLY_BUDGET_KRW=3000

# 임베딩(bge-m3)은 LLM과 별개로 로컬 Ollama 를 쓴다(ollama pull bge-m3). 보통 넣지 않는다
# EMBED_BASE_URL=http://localhost:11434

# 한국관광공사 TourAPI (data.go.kr)
TOUR_API_KEY=
# 긴급: 국립중앙의료원 응급실·약국(data.go.kr), V-World 좌표→주소
NMC_API_KEY=
VWORLD_API_KEY=
